{
  "name": "mmm-eye-film",
  "version": "1.0.0",
  "description": "Plugin to show the movies currently playing in the Eye filmmuseum on a Magic Mirror",
  "main": "MMM-Eye-Film.js",
  "scripts": {
    "build": "rollup -c",
